<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profileUser.username %> | Connect Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; }
        .profile-header { background: white; border-bottom: 1px solid #ddd; }
        .avatar-lg { width: 120px; height: 120px; font-size: 3rem; background-color: #e4e6eb; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-white bg-white shadow-sm mb-0">
        <div class="container">
            <a class="navbar-brand text-primary fw-bold" href="/posts">OdinBook</a>
            <a href="/posts" class="btn btn-outline-secondary btn-sm">Back to Feed</a>
        </div>
    </nav>

    <div class="profile-header py-4 mb-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="avatar-lg rounded-circle d-flex align-items-center justify-content-center text-secondary">
                        <%= profileUser.username.charAt(0).toUpperCase() %>
                    </div>
                </div>
                <div class="col">
                    <h1 class="fw-bold mb-0"><%= profileUser.username %></h1>
                    <div class="d-flex gap-3 mt-2">
                        <span><strong><%= profileUser._count.followers %></strong> Followers</span>
                        <span><strong><%= profileUser._count.following %></strong> Following</span>
                    </div>
                </div>
                <div class="col-auto">
                    <% if (currentUser && currentUser.id !== profileUser.id) { %>
                        <% if (profileUser.followers && profileUser.followers.some(f => f.followerId === currentUser.id)) { %>
                            <form action="/users/<%= profileUser.id %>/unfollow" method="POST">
                                <button class="btn btn-secondary fw-bold">Unfollow</button>
                            </form>
                        <% } else { %>
                            <form action="/users/<%= profileUser.id %>/follow" method="POST">
                                <button class="btn btn-primary fw-bold">Follow</button>
                            </form>
                        <% } %>
                    <% } else if (currentUser && currentUser.id === profileUser.id) { %>
                        <button class="btn btn-light border fw-bold">Edit Profile</button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h5 class="fw-bold mb-3">Posts</h5>
                
                <% if (profileUser.posts && profileUser.posts.length > 0) { %>
                    <% profileUser.posts.forEach(post => { %>
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-body">
                                <p class="card-text"><%= post.content %></p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted"><%= post.createdAt.toDateString() %></small>
                                    <div class="text-muted small">
                                        <span>👍 <%= post.likes ? post.likes.length : 0 %></span>
                                        <span class="ms-2">💬 <%= post.comments ? post.comments.length : 0 %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="card border-0 shadow-sm text-center p-5">
                        <p class="text-muted mb-0">This user hasn't posted anything yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>