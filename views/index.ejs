<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connect Hub | Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; } 
        .navbar-brand { font-weight: bold; color: #0866ff; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-white bg-white shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand" href="/posts">OdinBook</a>
            <div class="ms-auto">
                <% if (currentUser) { %>
                    <span class="me-3 text-muted">Hi, <strong><%= currentUser.username %></strong></span>
                    <form action="/auth/logout" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Log Out</button>
                    </form>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline-primary btn-sm">Login</a>
                    <a href="/auth/signup" class="btn btn-primary btn-sm">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <div class="col-md-3 d-none d-md-block">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title">Home</h5>
                        <p class="text-muted">Welcome to your feed.</p>
                        <% if (currentUser) { %>
                            <a href="/users/<%= currentUser.id%>/show" class="btn btn-light btn-sm w-100">My Profile</a>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <% if (currentUser) { %>
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-body">
                            <form action="/posts" method="POST">
                                <textarea name="content" class="form-control border-0 bg-light" rows="3" placeholder="What's on your mind?" required></textarea>
                                <hr>
                                <button type="submit" class="btn btn-primary w-100">Post</button>
                            </form>
                        </div>
                    </div>
                <% } %>

                <% if (locals.posts && posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <div class="card shadow-sm border-0 mb-3">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2">
                                    <a href="/users/<%= post.author.id %>" class="text-decoration-none fw-bold">
                                        <%= post.author.username %>
                                    </a>
                                </h6>
                                <p class="card-text"><%= post.content %></p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted"><%= post.createdAt.toDateString() %></small>
                                    <div>
                                        <button class="btn btn-light btn-sm">👍 Like</button>
                                        <a href="/posts/<%= post.id %>" class="btn btn-light btn-sm">💬 Comment</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center py-5 text-muted">
                        <p>No posts yet. Start the conversation!</p>
                    </div>
                <% } %>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Suggestions</h6>
                        <% if (locals.users) { %>
                            <% users.forEach(user => { %>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                <small><%= user.username %></small>
                                <div>
                                    <button class="btn btn-outline-primary btn-sm py-0 me-1" 
                                            onclick="openChat('<%= user.id %>', '<%= user.username %>')">
                                        ✉️
                                    </button>
                                </div>
                            </div>
                            <% }) %>
                        <% } else { %>
                            <small class="text-muted">No suggestions available.</small>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="chat-window" class="card shadow-lg d-none" style="position: fixed; bottom: 20px; right: 20px; width: 300px; z-index: 1000;">
        <div class="card-header bg-primary text-white d-flex justify-content-between">
            <span id="chat-with-name">Chat</span>
            <button class="btn-close btn-close-white" onclick="closeChat()"></button>
        </div>
        <div id="chat-messages" class="card-body bg-light" style="height: 250px; overflow-y: auto; font-size: 0.9rem;">
            </div>
        <div class="card-footer bg-white">
            <div class="input-group">
                <input type="text" id="msg-input" class="form-control form-control-sm" placeholder="Type a message...">
                <button class="btn btn-primary btn-sm" onclick="sendMsg()">Send</button>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        let activeRecipientId = null;

        const currentUserId = "<%= currentUser ? currentUser.id : '' %>";

        
        socket.on('connect', () => {
            console.log("Connected to server!"); 
            if (currentUserId) {
                socket.emit('join-room', currentUserId);
            }
        });
        
        async function openChat(userId, username){
            activeRecipientId = userId;
            const container = document.getElementById('chat-messages');
            container.innerHTML = '';

            document.getElementById('chat-window').classList.remove('d-none');
            document.getElementById('chat-with-name').innerText = `Chat with ${username}`;
            try{
                const response = await fetch(`/messages/${userId}`);
                const messages = await response.json();

                messages.forEach(msg => {
                    const senderName = msg.senderId == currentUserId ? 'You' : username;
                    appendMessage(senderName,msg.content);
                });
            }catch(err){
                console.log("Could not load messages",err);
                container.innerHTML = 'Could not load messages';
            }
        }

        function closeChat(){
            document.getElementById('chat-window').classList.add('d-none');
            activeRecipientId = null;
        }

        function sendMsg(){
            const input = document.getElementById('msg-input');
            const content = input.value;
            if (!content || !activeRecipientId ) return;

            socket.emit('send-private-message',{
                senderId: currentUserId,
                receiverId: activeRecipientId,
                content: content 
            });

            appendMessage('You', content);
            input.value = '';
        }

        socket.on('receive-message', (data) => {

            console.log("Message received for room:", data.receiverId);
            if (activeRecipientId == data.senderId) {
                appendMessage(data.sender.username, data.content);
            } else {
                alert(`New message from ${data.sender.username}: ${data.content}`);
            }
        });
        function appendMessage(sender, text) {
        const container = document.getElementById('chat-messages');
        container.innerHTML += `<div><strong>${sender}:</strong> ${text}</div>`;
        container.scrollTop = container.scrollHeight;
    }
    </script>
</body>
</html>